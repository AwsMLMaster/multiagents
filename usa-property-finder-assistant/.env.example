# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.1
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# AWS Bedrock Knowledge Base (real estate glossary / FAQ / guides)
KB_ID=
KB_MAX_RESULTS=5
KB_CONFIDENCE_THRESHOLD=0.5

# Property Data Provider (ATTOM Data / Realtor.com RapidAPI / MLS Grid)
PROPERTY_DATA_PROVIDER=attom
PROPERTY_DATA_BASE_URL=https://api.gateway.attomdata.com
PROPERTY_DATA_API_KEY=
PROPERTY_DATA_TIMEOUT=15

# Geocoding (Google Maps / Mapbox)
GEOCODING_PROVIDER=google
GEOCODING_API_KEY=

# Mortgage Rates Provider (Freddie Mac PMMS / RapidAPI)
MORTGAGE_RATES_API_KEY=
MORTGAGE_RATES_BASE_URL=

# Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
DYNAMODB_SESSION_TABLE=property-finder-sessions
CACHE_DEFAULT_TTL=3600
SESSION_TTL=1800

# Observability
SERVICE_NAME=usa-property-finder-assistant
ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ENABLED=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=usa-property-finder-assistant
LANGSMITH_ENABLED=true
LOG_LEVEL=INFO

# Security
MAX_INPUT_LENGTH=2000
ENABLE_PII_DETECTION=true
ENABLE_INJECTION_DETECTION=true
ENABLE_FAIR_HOUSING_GUARD=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
